{
  "name": "ContactInquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "structural_analysis",
        "architectural_design",
        "project_management",
        "construction_supervision",
        "geotechnical_engineering",
        "mep_engineering",
        "other"
      ],
      "description": "Type of consultancy needed"
    },
    "project_location": {
      "type": "string",
      "description": "Project location"
    },
    "message": {
      "type": "string",
      "description": "Additional details"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "description": "Language preference"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "in_progress",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "service_type"
  ]
}